# Key from Google AI Studio (https://aistudio.google.com/apikey).
# Read only by the retouch helper (`apps/gemini-retouch`), not by PhotoCraft itself.
# People using the installed app can paste the key into the helper's browser page instead.
GEMINI_API_KEY=

# Optional listen address. Loopback only. Default: 127.0.0.1:8787
# RETOUCH_ADDR=127.0.0.1:8787
