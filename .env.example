# Debug only (`cargo run`). Release builds, installers, and the portable zip never read this
# file or GEMINI_API_KEY from the environment. Those programs ask on the retouch page.
# Key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional listen address. Loopback only. Default: 127.0.0.1:8787
# RETOUCH_ADDR=127.0.0.1:8787
